# Copy to wrangler.toml and fill in your own values.
name = "gumleaf"
main = "src/index.ts"
compatibility_date = "2025-06-01"

[vars]
# NWS and MET Norway require an identifying User-Agent with a REAL contact.
# IMPORTANT: MET Norway rejects placeholder contacts (anything with example.com)
# with HTTP 403, which silently breaks non-US weather. Use your real email or URL.
WEATHER_USER_AGENT = "gumleaf/1.0 (contact: REPLACE-with-your-real-email)"
# Answer model. Use whatever your provider offers (see "Choosing your LLM" in README).
LLM_MODEL = "gpt-4o"
# Optional: point at any OpenAI-compatible provider. Default is OpenAI.
#   OpenRouter: "https://openrouter.ai/api"   Groq: "https://api.groq.com/openai"
#   Local (Ollama/LM Studio): "http://localhost:11434"
# LLM_BASE_URL = "https://api.openai.com"
# Moderation hits OpenAI's free endpoint; skipped (fails open) for non-OpenAI keys
# unless you set MODERATION_API_KEY (a secret) to an OpenAI key. On by default;
# set MODERATION_ENABLED = "false" to turn it off (e.g. a fully-local/private setup).
# MODERATION_ENABLED = "false"
# Optional: default place for weather questions with no location.
# DEFAULT_LOCATION = "Denver, CO"
# Optional: per-number monthly answer cap (cost guard). Omit for unlimited.
# MONTHLY_LIMIT = "200"
# Optional: public URL of your bot's .vcf contact card (generate one with
# scripts/make-vcard.sh, host it with Content-Type: text/vcard). When set,
# first contact and the CONTACT/VCARD/CARD/SAVE keyword send the card as MMS.
# VCARD_URL = "https://your-site.example/yourbot.vcf"

[[kv_namespaces]]
binding = "SMS_STATE"
id = "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
